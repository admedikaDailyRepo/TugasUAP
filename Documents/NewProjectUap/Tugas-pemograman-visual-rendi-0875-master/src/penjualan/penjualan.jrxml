<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="nota_visual" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="791cd072-8c16-4a36-9639-b63ba987c2fe">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_nota" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     barang.`id_brg` AS barang_id_brg,
     barang.`nm_brg` AS barang_nm_brg,
     barang.`jenis` AS barang_jenis,
     barang.`hargabeli` AS barang_hargabeli,
     barang.`hargajual` AS barang_hargajual,
     pelanggan_rendi.`nmplgn` AS pelanggan_rendi_nmplgn,
     pelanggan_rendi.`jenis` AS pelanggan_rendi_jenis,
     pelanggan_rendi.`telepon` AS pelanggan_rendi_telepon,
     pelanggan_rendi.`alamat` AS pelanggan_rendi_alamat,
     nota.`id_nota` AS nota_id_nota,
     nota.`tgl_nota` AS nota_tgl_nota,
     nota.`id_plgn` AS nota_id_plgn,
     nota.`id_kasir` AS nota_id_kasir,
     isi.`id_nota` AS isi_id_nota,
     isi.`kd_brg` AS isi_kd_brg,
     isi.`hb` AS isi_hb,
     isi.`hj` AS isi_hj,
     isi.`qty` AS isi_qty,
     kasir.`id` AS kasir_id,
     kasir.`nm_kasir` AS kasir_nm_kasir,
     kasir.`jenis_kelamin` AS kasir_jenis_kelamin,
     kasir.`no_telepon` AS kasir_no_telepon,
     kasir.`agama` AS kasir_agama,
     kasir.`alamat` AS kasir_alamat,
     kasir.`password` AS kasir_password,
     pelanggan_rendi.`id` AS pelanggan_rendi_id
FROM
     `nota` nota INNER JOIN `pelanggan_rendi` pelanggan_rendi ON nota.`id_nota` = pelanggan_rendi.`id`
     INNER JOIN `isi` isi ON nota.`id_nota` = isi.`id_nota`
     INNER JOIN `barang` barang ON isi.`id_nota` = barang.`id_brg`
     INNER JOIN `kasir` kasir ON barang.`id_brg` = kasir.`id`
WHERE
nota.idnota=$P{id_nota}]]>
	</queryString>
	<field name="barang_id_brg" class="java.lang.Integer"/>
	<field name="barang_nm_brg" class="java.lang.String"/>
	<field name="barang_jenis" class="java.lang.String"/>
	<field name="barang_hargabeli" class="java.lang.String"/>
	<field name="barang_hargajual" class="java.lang.String"/>
	<field name="pelanggan_rendi_nmplgn" class="java.lang.String"/>
	<field name="pelanggan_rendi_jenis" class="java.lang.String"/>
	<field name="pelanggan_rendi_telepon" class="java.lang.String"/>
	<field name="pelanggan_rendi_alamat" class="java.lang.String"/>
	<field name="nota_id_nota" class="java.lang.Integer"/>
	<field name="nota_tgl_nota" class="java.lang.Integer"/>
	<field name="nota_id_plgn" class="java.lang.Integer"/>
	<field name="nota_id_kasir" class="java.lang.Integer"/>
	<field name="isi_id_nota" class="java.lang.Integer"/>
	<field name="isi_kd_brg" class="java.lang.Integer"/>
	<field name="isi_hb" class="java.lang.Integer"/>
	<field name="isi_hj" class="java.lang.Integer"/>
	<field name="isi_qty" class="java.lang.Integer"/>
	<field name="kasir_id" class="java.lang.Integer"/>
	<field name="kasir_nm_kasir" class="java.lang.String"/>
	<field name="kasir_jenis_kelamin" class="java.lang.String"/>
	<field name="kasir_no_telepon" class="java.lang.String"/>
	<field name="kasir_agama" class="java.lang.String"/>
	<field name="kasir_alamat" class="java.lang.String"/>
	<field name="kasir_password" class="java.lang.String"/>
	<field name="pelanggan_rendi_id" class="java.lang.Integer"/>
	<variable name="subtotal" class="java.lang.String">
		<variableExpression><![CDATA[$F{isi_qty}*$F{isi_hj}$F{isi_hj}]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.String" calculation="Sum">
		<variableExpression><![CDATA[$V{subtotal}]]></variableExpression>
	</variable>
